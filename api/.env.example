# Copier ce fichier vers api/.env (non versionné) et adapter les valeurs.
# Sur Render, ces variables sont définies par render.yaml ou le dashboard : ce fichier n'y est pas utilisé.

# Obligatoire : connexion PostgreSQL
DATABASE_URL=postgres://utilisateur:mot_de_passe@localhost:5432/pollution_db

# Facultatif : SSL activé par défaut, sauf sur localhost (true ou false pour forcer)
# DB_SSL=false

# Facultatif : port de l'API (3000 par défaut, celui attendu par le front en développement)
# PORT=3000
